namespace agave.ledger.broadcast_events;

struct Hash {
  bytes: [ubyte:32];
}

struct NewBankEvent {
  slot: ulong;
  parent_slot: ulong;
  parent_hash: Hash;
}

struct FrozenBankEvent {
  slot: ulong;
  bank_hash: Hash;
}

table BankEvent {
  timestamp: ulong;
  new_bank: NewBankEvent;
  frozen_bank: FrozenBankEvent;
}

root_type BankEvent;
