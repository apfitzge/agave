namespace agave.ledger.broadcast_events;

struct Hash {
  bytes: [ubyte:32];
}

table NewBankEvent {
  slot: ulong;
  parent_slot: ulong;
  parent_hash: Hash;
}

table FrozenBankEvent {
  slot: ulong;
  bank_hash: Hash;
}

union BankEventPayload {
  NewBankEvent,
  FrozenBankEvent,
}

table BankEvent {
  timestamp: ulong;
  payload: BankEventPayload;
}

root_type BankEvent;
